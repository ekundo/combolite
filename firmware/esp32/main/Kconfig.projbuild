menu "Плата COMBOLITE"

config COMBO_WIFI_SSID
    string "Имя сети WiFi"
    default "myssid"

config COMBO_WIFI_PASS
    string "Пароль сети WiFi"
    default ""
    help
        Задаётся здесь, а не в исходниках: sdkconfig в дерево не коммитится.

config COMBO_TOKEN
    string "Имя экспорта NBD"
    default ""
    help
        Пароля в протоколе NBD нет, поэтому секретом служит имя экспорта:
        nbd-client ... -N <токен>. Пусто — проверки нет.
        К морде и к API это отношения не имеет, у них своя схема, см. ниже.

config COMBO_SECRET
    string "Секрет доступа к API"
    default ""
    help
        Пусто — плата создаст 128 бит сама при первом запуске, положит в NVS и
        напечатает ОДИН раз в консоль. Так и задумано: у каждой платы свой
        сильный секрет, и никто не оставит заводской.

        Задавать здесь стоит, только если хотите распоряжаться им сами. Тогда
        он обязан быть СЛУЧАЙНЫМ: перехватив вызов и одну подпись, его можно
        подбирать не обращаясь к плате, и придуманный пароль такую схему
        сломает.

config COMBO_WRITE_WINDOW
    int "Сколько секунд действует разрешение записи"
    default 300
    help
        Запись требует явного разрешения: POST /api/unlock, и оно живёт столько
        секунд. Ноль — разрешения не требуется вовсе.

        Диск у машины один и ему тридцать лет, а самая вероятная беда с ним не
        злоумышленник, а случайная запись: чужая вкладка, ошибка в морде, промах
        мышью. Окно превращает запись из состояния в намерение и заодно
        ограничивает ущерб от захваченной сессии.

config COMBO_ALLOW_HTTP
    string "Кому открыт HTTP"
    default ""
    help
        Список адресов через запятую: "192.168.1.10,10.0.0.0/8". Пусто — всем.
        За обратным прокси здесь стоит указать один его адрес.

        Это ПЕРИМЕТР, а не авторизация: подменивший ARP посредник встаёт на
        место разрешённого адреса. Проверку секрета список не заменяет.

config COMBO_ALLOW_NBD
    string "Кому открыт NBD"
    default ""
    help
        То же для порта NBD. Список свой, не общий с HTTP: через обратный
        прокси NBD не ходит, его клиенты обращаются к плате напрямую.

        Обмен идёт по обычному HTTP, поэтому токен уходит по сети открытым.
        От чужого в вашей сети он не защитит — только от того, кто в неё не
        вхож. Берите строку подлиннее и не ту, что где-то ещё.

config COMBO_HTTP_PORT
    int "Порт вебморды"
    default 80

config COMBO_NBD_PORT
    int "Порт NBD"
    default 10809

config COMBO_READ_ONLY
    bool "Объявлять диск по NBD только для чтения"
    default y
    help
        Про NBD, и только про него. По умолчанию включено, и это осознанно:
        если «Вектор» в это время сам пишет на диск, а клиент NBD смонтирован
        на запись, файловая система развалится — клиент кэширует, машина о нём
        не знает. Выключайте, только когда машина к диску не обращается.

        Запись из вебморды этим НЕ управляется: у неё своя защита — окно
        разрешения, см. COMBO_WRITE_WINDOW. Опасности у них разные. Смонтиро-
        ванная файловая система пишет когда сама сочтёт нужным и вразнобой с
        машиной; морда пишет ровно то и тогда, что человек нажал.

config COMBO_WEB_READ_ONLY
    bool "Запретить запись через вебморду совсем"
    default n
    help
        Крайняя мера: морда не сможет писать вообще, и окно разрешения ей не
        поможет. Нужна разве что для платы, выставленной на общий показ.

        В обычной работе выключено: смысл морды в том и есть, чтобы что-то
        положить на диск, а от случайной записи защищает окно.

# ESP32-S3: модуль на плате, выводы 10..13 -- штатные выводы FSPI.
config COMBO_SPI_HOST
    int "Номер контроллера SPI"
    default 1 if IDF_TARGET_ESP32S3
    default 2

config COMBO_SPI_HZ
    int "Частота SPI, Гц"
    default 4000000
    help
        Предел задаёт ведомый в ПЛИС: он передискретизирует SCK на 50 МГц и
        меняет MISO через 45..65 нс после спада SCK (два-три такта плюс
        выводы), а читаем мы MISO через полпериода. Отсюда ~7,5 МГц.
        На живой плате так и выходит: 8 МГц не работает вовсе, 7 и ниже — без
        единой ошибки. Разбор в fpga/hdl/spi_slave.v.

        Отказ выглядит не как молчание, а как сдвиг данных на разряд: пишешь
        0x02, читаешь 0x01 или 0x03. Обманчиво тем, что 0x00 и 0xFF от сдвига
        не меняются и проходят всегда. Поднимаешь частоту — проверяй эхо-тестом
        регистров: сдвиг ловится только сравнением записанного с прочитанным.

        Отсюда 4 МГц по умолчанию, вдвое ниже отказа. Цена: SPI и есть узкое
        место, сектор по SPI на 4 МГц идёт 1048 мкс против 189 мкс с привода.

config COMBO_FAKE_DRIVE
    bool "Привод-генератор вместо настоящего (только для замеров)"
    default n
    help
        Секторы считаются на лету: заголовок винта, метки и каталоги 324 дискет.
        Нужен, чтобы измерить скорость самой морды на плате, пока нет ПЛИС и
        привода. В боевой прошивке не включать: диска за этим нет, а запись
        живёт в памяти до перезагрузки.

config COMBO_PIN_SCK
    int "Вывод такта"
    default 12 if IDF_TARGET_ESP32S3
    default 18
config COMBO_PIN_MOSI
    int "Вывод данных к ПЛИС"
    default 11 if IDF_TARGET_ESP32S3
    default 23
config COMBO_PIN_MISO
    int "Вывод данных от ПЛИС"
    default 13 if IDF_TARGET_ESP32S3
    default 19
config COMBO_PIN_CS
    int "Вывод выбора"
    default 10 if IDF_TARGET_ESP32S3
    default 5

# SSPI конфигурации ПЛИС: им ESP прошивает флеш ПЛИС (sspi.c).
config COMBO_PIN_SSPI_CSSPIN
    int "SSPI: CSSPIN (держится снятым)"
    depends on IDF_TARGET_ESP32S3
    default 4
config COMBO_PIN_SSPI_CCLK
    int "SSPI: MCLK/CCLK"
    depends on IDF_TARGET_ESP32S3
    default 5
config COMBO_PIN_SSPI_SI
    int "SSPI: SI (к ПЛИС)"
    depends on IDF_TARGET_ESP32S3
    default 6
config COMBO_PIN_SSPI_SO
    int "SSPI: SO (от ПЛИС)"
    depends on IDF_TARGET_ESP32S3
    default 7
config COMBO_PIN_SSPI_SN
    int "SSPI: SN (выбор)"
    depends on IDF_TARGET_ESP32S3
    default 15

config COMBO_USB_MOUSE
    bool "USB-мышь в розетке платы"
    depends on IDF_TARGET_ESP32S3
    default y
    help
        Отчёты мыши уходят в ПЛИС пакетом C_MOUSE, машина читает их с порта
        D4h (интерфейс KTSerg, fpga/hdl/mouse.v). Нужен USB OTG ESP32-S3.
        Розетка и USB-Serial-JTAG делят одни выводы 19/20, поэтому вторая
        консоль на USB у этой сборки выключена (журнал -- по WiFi и на
        площадках UART0).

# JTAG ПЛИС на плате выведен только на контрольные точки, а с ESP ПЛИС
# прошивается по SSPI. Сборка берёт jtag_fake.c и выводы ниже не трогает
# (у S3 26..32 -- флеш модуля).
config COMBO_PIN_TCK
    int "JTAG TCK (на этой плате не используется)"
    default 26
config COMBO_PIN_TMS
    int "JTAG TMS (на этой плате не используется)"
    default 27
config COMBO_PIN_TDI
    int "JTAG TDI (на этой плате не используется)"
    default 25
config COMBO_PIN_TDO
    int "JTAG TDO (на этой плате не используется)"
    default 33

endmenu
