# Сторож задач: опрос состояния бывает долгим, но link_espidf.c уступает
# планировщику сам, поэтому сторожа не отключаем, а оставляем как страховку.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Стек главной задачи: в session() лежит буфер сектора, плюс стек lwIP.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Окна побольше: NBD гоняет сектора подряд, и на умолчаниях lwIP упирается в
# окно раньше, чем в SPI. Алгоритм Нейгла тут ни при чём — его снимает
# TCP_NODELAY, и это уже сделано в net.c.
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768

# Флеш 4 МБ, а не умолчательные 2.
#
# Разделы просят 3,1 МБ: два мегабайта под приложение и мегабайт под статику,
# плюс служебное. На умолчании сборка встаёт с «does not fit in configured flash
# size 2MB» -- и встаёт на генерации таблицы разделов, то есть до единой строки
# нашего кода.
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Своя таблица разделов: нужен раздел www под статику.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 802.11k и v: роуминг силами самой сети.
#
# k даёт список соседних точек от той, к которой мы подключены, — не нужно
# обходить все каналы самим. v позволяет попросить сеть перевести нас на другую
# точку: она делает это МЯГКО, сменой ассоциации, и открытые соединения
# переживают переход. Наш собственный путь так не умеет — он рвёт связь и
# собирает её заново, а если в этот миг шло применение, оно оборвётся.
#
# Настройки «включить роуминг» нет намеренно. Точка сама объявляет поддержку,
# esp_wnm_is_btm_supported_connection про неё спрашивает, и при отказе работает
# прежний путь. Заставлять человека знать про свою точку такое незачем.
CONFIG_ESP_WIFI_11KV_SUPPORT=y

# Откат к прежней прошивке, если новая не запустилась.
#
# БЕЗ ЭТОГО ОТКАТА НЕТ ВОВСЕ: загрузчик по умолчанию просто грузит то, что ему
# указали, и неудачная сборка оставляет плату в вечной перезагрузке. С ним новая
# прошивка считается испытательной, пока сама не скажет «я работаю», -- это
# делает ota_mark_good() перед запуском сервера, то есть после того, как
# поднялись сеть и файловая система. Не дошло до этого места -- при следующем
# включении загрузится прежняя.
#
# Ради чего: плата стоит в машине без шнурка. Ошибиться в сборке можно всегда,
# а разбирать «Вектор» ради этого нельзя.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
