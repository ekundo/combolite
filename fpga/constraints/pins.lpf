# Ограничения для LCMXO2-7000HE-4TG144C, корпус TQFP144.
# Файл сгенерирован по таблице выводов Lattice (MachXO2-7000Pinout.csv).
#
# Прибор: LCMXO2-7000HE-4TG144C (в проекте Diamond — он же).
# DEVICE: LCMXO2-7000HE-4TG144C
#
# Посадочное место то же, что у LCMXO2-4000: по миграционному файлу
# Lattice сходятся все выводы, сколько их есть (144): банк и
# дополнительная функция те же. У 94 различаются только внутренние имена
# площадок — важно, только если привязываться по имени площадки, а не по
# номеру.
#
# Посадочное место разводится под оба сорта 7000-го, HC и HE. Даташит
# FPGA-DS-02056-4-7, Introduction: «With the exception
# of power supply voltage all three types of devices (ZE, HC and HE) are
# functionally compatible and pin compatible with each other». Разница
# только в питании VCC (выводы 36, 72, 108, 144): HC принимает 3,3 или
# 2,5 В, ZE и HE — только 1,2 В.
#
# Не занимать никогда: 120 JTAGENB, 130 TMS, 131 TCK, 136 TDI, 137 TDO.
# Вывод 120 (JTAGENB) управляет тем, работают ли TDI/TDO/TMS/TCK как JTAG;
# на плате он подтянут 1 кОм вверх.

BLOCK RESETPATHS;
BLOCK ASYNCPATHS;
# Переходы между тактами clk50, clkv, clk16 Diamond проверял бы как
# синхронные: все три от одной ФАПЧ. Каждый переход в HDL сделан
# нарочно — синхронизатор на 2-3 триггера, двухтактовая EBR или строб,
# стоящий сотни нс.
BLOCK INTERCLOCKDOMAIN PATHS;

# Генератор 50,000 МГц на PCLKT5_0. Дальше ФАПЧ (hdl/pll_fdc.v): 53,333 МГц
# точке VGA и 16 МГц ядру ВГ93; их частоты Diamond выводит из ФАПЧ сам.
# Такт AY 1,750000 МГц — дробным делением от 50, см. hdl/ay_iface.v.
# Число здесь задаёт, с чем сверяется отчёт по времени: поставить
# меньше действительного значит получить ложный запас.
FREQUENCY PORT "clk50" 50.000000 MHz;

# Выходы ФАПЧ (hdl/pll_fdc.v), в Map — цепи верхнего уровня pll/pll.
# Без этих строк Synplify считает их «inferred clock» и проверяет по
# 50 МГц из build.tcl — строже, но отчёт по времени не про наши такты.
FREQUENCY NET "clkv" 53.333333 MHz;
FREQUENCY NET "clk16" 16.000000 MHz;

# Такт защёлки 574: чистая комбинация ras_n -> latch_clk, тактовая
# частота её не покрывает, и без этой строки отчёт о ней промолчит.
#
# 10 нс здесь — НЕ требование, а сторожевой порог. Требование измерено
# на машине: адрес строки держится 100 нс, из них 5 забирает установка
# защёлки, остальное делят кристалл и два транслятора. Кристаллу
# достаётся порядка 85 нс, а он берёт 7,731 — меньше десятой части.
#
# Порог оставлен тесным намеренно: он должен сработать, если правка HDL
# или другое размещение утроят задержку, — задолго до того, как это
# станет опасным. Ослаблять его до настоящих 85 нс значит выключить
# предупреждение. Diamond 3.5 строку принимает.
MAXDELAY FROM PORT "ras_n" TO PORT "latch_clk" 10.000000 nS;

# Сам гейт -- у выводов: ras_n 143 (PT9A) и latch_clk 141 (PT10A) на
# верхнем краю. Без привязки размещение уводит его в середину
# кристалла: 12,65 нс вместо 7,61 с привязкой, сторож выше срабатывает.
# Гейт -- модуль lclk_gate (hdl/vu_bus.v) с syn_hier="hard", имя
# core/bus/lclk постоянное. Область -- строки 2-4, столбцы 8-12, там же,
# где размещение ставит его само (R3C11D).
UGROUP "LCLK_GRP" BLKNAME core/bus/lclk;
REGION "LCLK_REG" "R2C8D" 3 5 DEVSIZE;
LOCATE UGROUP "LCLK_GRP" REGION "LCLK_REG";

# Сторожа путей вход -> выход, смысл тот же, что у порога latch_clk выше.
# Только FROM PORT: от триггера к latch_clk2 13,0 нс, больше порога.
MAXDELAY FROM PORT "cas_n" TO PORT "latch_clk2" 12.000000 nS;
MAXDELAY TO PORT "buf_oe_n" 36.000000 nS;
MAXDELAY TO PORT "buf_dir" 36.000000 nS;
MAXDELAY TO PORT "shd_dir" 36.000000 nS;
MAXDELAY TO PORT "shd[0]" 36.000000 nS;
MAXDELAY TO PORT "shd[1]" 36.000000 nS;
MAXDELAY TO PORT "shd[2]" 36.000000 nS;
MAXDELAY TO PORT "shd[3]" 36.000000 nS;
MAXDELAY TO PORT "shd[4]" 36.000000 nS;
MAXDELAY TO PORT "shd[5]" 36.000000 nS;
MAXDELAY TO PORT "shd[6]" 36.000000 nS;
MAXDELAY TO PORT "shd[7]" 36.000000 nS;
MAXDELAY TO PORT "blk_n" 25.000000 nS;
MAXDELAY TO PORT "sram_ce0_n" 25.000000 nS;
MAXDELAY TO PORT "sram_ce1_n" 25.000000 nS;
MAXDELAY TO PORT "sram_page[0]" 25.000000 nS;
MAXDELAY TO PORT "sram_page[1]" 25.000000 nS;
MAXDELAY TO PORT "sram_page[2]" 25.000000 nS;
MAXDELAY TO PORT "addr_src" 21.000000 nS;
MAXDELAY TO PORT "ide_dd[0]" 29.000000 nS;
MAXDELAY TO PORT "ide_dd[1]" 29.000000 nS;
MAXDELAY TO PORT "ide_dd[2]" 29.000000 nS;
MAXDELAY TO PORT "ide_dd[3]" 29.000000 nS;
MAXDELAY TO PORT "ide_dd[4]" 29.000000 nS;
MAXDELAY TO PORT "ide_dd[5]" 29.000000 nS;
MAXDELAY TO PORT "ide_dd[6]" 29.000000 nS;
MAXDELAY TO PORT "ide_dd[7]" 29.000000 nS;
MAXDELAY TO PORT "ide_dd[8]" 29.000000 nS;
MAXDELAY TO PORT "ide_dd[9]" 29.000000 nS;
MAXDELAY TO PORT "ide_dd[10]" 29.000000 nS;
MAXDELAY TO PORT "ide_dd[11]" 29.000000 nS;
MAXDELAY TO PORT "ide_dd[12]" 29.000000 nS;
MAXDELAY TO PORT "ide_dd[13]" 29.000000 nS;
MAXDELAY TO PORT "ide_dd[14]" 29.000000 nS;
MAXDELAY TO PORT "ide_dd[15]" 29.000000 nS;
MAXDELAY TO PORT "ide_cs0_n" 29.000000 nS;
MAXDELAY TO PORT "ide_dior_n" 29.000000 nS;
MAXDELAY TO PORT "ide_diow_n" 29.000000 nS;
MAXDELAY TO PORT "ide_dd_dir" 29.000000 nS;
MAXDELAY TO PORT "ide_da[0]" 29.000000 nS;
MAXDELAY TO PORT "ide_da[1]" 29.000000 nS;
MAXDELAY TO PORT "ide_da[2]" 29.000000 nS;

# Порты конфигурации — в Feature Row, TN-02155, таблица 7.1. По
# умолчанию SLAVE_SPI_PORT ВЫКЛЮЧЕН, а прошивка ПЛИС с ESP идёт ровно
# через него: без ENABLE ESP не перешьёт кристалл после первой загрузки.
# SDM_PORT=DISABLE — DONE, INITN, PROGRAMN заняты сигналами (см. конец файла);
# I2C_PORT=DISABLE — его выводы тоже сигналы. JTAG остаётся.
# Если Diamond строку не примет — те же значения в Spreadsheet View,
# Global Preferences.
SYSCONFIG JTAG_PORT=ENABLE SLAVE_SPI_PORT=ENABLE MASTER_SPI_PORT=DISABLE I2C_PORT=DISABLE SDM_PORT=DISABLE ;

LOCATE COMP "ide_dd[8]" SITE "1";  # PL3A, банк 5, L_GPLLT_FB
LOCATE COMP "ide_dd[9]" SITE "2";  # PL3B, банк 5, L_GPLLC_FB
LOCATE COMP "ide_dd[7]" SITE "3";  # PL4A, банк 5, L_GPLLT_IN
LOCATE COMP "ide_dd[10]" SITE "4";  # PL4B, банк 5, L_GPLLC_IN
LOCATE COMP "clk50" SITE "5";  # PL6A, банк 5, PCLKT5_0
LOCATE COMP "ide_dd[6]" SITE "6";  # PL6B, банк 5, PCLKC5_0
LOCATE COMP "ide_dd[11]" SITE "9";  # PL8A, банк 5
LOCATE COMP "ide_dd[5]" SITE "10";  # PL8B, банк 5
